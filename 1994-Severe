<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CWN — 1994 SEVERE WEATHER BULLETIN</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
*{margin:0;padding:0;box-sizing:border-box;}

#scaleWrapper{
    width:1920px;
    height:1080px;
    transform-origin:top left;
    position:absolute;
    top:0;
    left:0;
}

/* BASE */
html,body{
    width:100%;
    height:100%;
    overflow:hidden;
    background:#000;
    font-family:'Courier New', monospace;
    color:#FFEFD5;
}

/* CRT EFFECT */
body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    background:repeating-linear-gradient(
        0deg,
        rgba(255,255,255,.02) 0px,
        rgba(255,255,255,.02) 1px,
        transparent 2px,
        transparent 4px
    );
}
body::after{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    background:radial-gradient(
        ellipse at center,
        rgba(0,0,0,.0) 40%,
        rgba(0,0,0,.7) 100%
    );
}

/* HEADER */
.header{
    height:110px;
    background:linear-gradient(90deg,#3b0000,#7a0000,#b00000);
    border-bottom:6px solid #FFCC00;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:0 30px;
}

.network-title{
    font-size:46px;
    letter-spacing:3px;
    color:#FFEFD5;
    text-shadow:2px 0 #FF0000,-2px 0 #FFCC00;
}

.header-sub{
    font-size:22px;
    color:#FFCC99;
}

.severe-label{
    font-size:32px;
    padding:10px 18px;
    border:3px solid #FFCC00;
    color:#FFCC00;
}

.clock-box{
    width:380px;
    height:80px;
    background:#120000;
    border:3px solid #FFCC00;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    gap:2px;
}

.clock{
    font-size:28px;
    color:#FFCC00;
}
.date{
    font-size:18px;
    color:#FFCC99;
}
.temp{
    font-size:22px;
    color:#FFCC99;
}

/* MAIN GRID */
.main{
    height:900px;
    padding:12px;
    display:grid;
    grid-template-columns:1100px 780px;
    grid-template-rows:900px;
    gap:12px;
    overflow:hidden;
}

/* LEFT RADAR PANEL */
.panel{
    background:#120000;
    border:4px solid #FFCC00;
    overflow:hidden;
    display:flex;
    flex-direction:column;
}

.panel-title{
    height:52px;
    line-height:52px;
    padding-left:16px;
    font-size:28px;
    background:linear-gradient(90deg,#3b0000,#7a0000);
    border-bottom:3px solid #FF0000;
    color:#FFEFD5;
}

.radar-window{
    flex:1;
    background:#000;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
}
.radar-window img{
    width:115%;
    height:115%;
    object-fit:cover;
    image-rendering:pixelated;
    filter:contrast(1.2) brightness(1.1);
}

/* RADAR LEGEND */
.radar-legend{
    height:90px;
    background:#120000;
    border-top:3px solid #FFCC00;
    padding:8px 16px;
    display:flex;
    flex-direction:column;
    gap:6px;
    font-size:18px;
    color:#FFEFD5;
}
.legend-row{
    display:flex;
    align-items:center;
    gap:10px;
}
.legend-swatch{
    width:18px;
    height:18px;
    border:1px solid #FFEFD5;
}
.legend-light{background:#00FF00;}
.legend-moderate{background:#FFFF00;}
.legend-heavy{background:#FF8000;}
.legend-severe{background:#FF0000;}

/* RIGHT COLUMN STACK */
.right-stack{
    display:grid;
    grid-template-rows:430px 430px;
    gap:12px;
}

/* BULLETIN */
.bulletin-content{
    padding:14px;
    font-size:22px;
    line-height:1.4;
    overflow:hidden;
}
.bulletin-line{
    margin-bottom:12px;
    color:#FFEFD5;
    font-size:24px;
    font-weight:bold;
}

/* YOUR LOCATION PANEL */
.location-content{
    padding:14px;
    font-size:22px;
    line-height:1.5;
}
.location-line{
    margin-bottom:10px;
    color:#FFCC99;
    font-size:22px;
}

/* BOTTOM TICKER */
.footer{
    height:70px;
    background:#120000;
    border-top:6px solid #FF0000;
    overflow:hidden;
}
.ticker-wrap{
    display:flex;
    width:max-content;
    animation:ticker 32s linear infinite;
}
.ticker-content{
    white-space:nowrap;
    font-size:24px;
    line-height:70px;
    color:#FFCC99;
    letter-spacing:3px;
    padding-right:140px;
}
@keyframes ticker{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
}
</style>
</head>

<body>
<div id="scaleWrapper">

    <!-- HEADER -->
    <div class="header">
        <div>
            <div class="network-title">CUMBERLAND WEATHER NET</div>
            <div class="header-sub">SEVERE WEATHER BULLETIN — 1994 STYLE</div>
        </div>
        <div class="severe-label">SEVERE WEATHER MODE</div>
        <div class="clock-box">
            <div class="clock" id="clock">--:-- --</div>
            <div class="date" id="date">Loading...</div>
            <div class="temp" id="temp">Temp: --°</div>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main">

        <!-- LEFT RADAR -->
        <div class="panel">
            <div class="panel-title">LIVE RADAR — MIDDLE TENNESSEE REGION</div>
            <div class="radar-window">
                <img src="https://radar.weather.gov/ridge/standard/KOHX_loop.gif">
            </div>
            <div class="radar-legend">
                <div>RADAR LEGEND</div>
                <div class="legend-row">
                    <div class="legend-swatch legend-light"></div><span>Light Rain</span>
                    <div class="legend-swatch legend-moderate"></div><span>Moderate Rain</span>
                </div>
                <div class="legend-row">
                    <div class="legend-swatch legend-heavy"></div><span>Heavy Rain</span>
                    <div class="legend-swatch legend-severe"></div><span>Severe Storms</span>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="right-stack">

            <!-- BULLETIN -->
            <div class="panel">
                <div class="panel-title">SEVERE WEATHER BULLETIN — LIVE ALERTS</div>
                <div class="bulletin-content" id="bulletinPanel"></div>
            </div>

            <!-- YOUR LOCATION -->
            <div class="panel">
                <div class="panel-title">YOUR LOCATION</div>
                <div class="location-content" id="locationPanel">
                    <div class="location-line">Detecting your location...</div>
                </div>
            </div>

        </div>
    </div>

    <!-- BOTTOM TICKER -->
    <div class="footer">
        <div class="ticker-wrap">
            <div class="ticker-content">
                CUMBERLAND WEATHER NET — MIDDLE TENNESSEE SEVERE WEATHER BULLETIN —
            </div>
            <div class="ticker-content">
                CUMBERLAND WEATHER NET — MIDDLE TENNESSEE SEVERE WEATHER BULLETIN —
            </div>
        </div>
    </div>

</div>

<script>
/* AUTO SCALE */
function scaleToFit(){
    const w = document.getElementById("scaleWrapper");
    const s = Math.min(window.innerWidth/1920, window.innerHeight/1080);
    w.style.transform = `scale(${s})`;
}
window.addEventListener("resize", scaleToFit);
window.addEventListener("load", scaleToFit);

/* CLOCK */
function updateClock(){
    const now = new Date();
    document.getElementById("clock").textContent =
        now.toLocaleTimeString("en-US",{hour:"numeric",minute:"numeric"});
    document.getElementById("date").textContent =
        now.toLocaleDateString("en-US",{weekday:"short",month:"short",day:"numeric"});
}
setInterval(updateClock,1000);
updateClock();

/* HEADER TEMPERATURE */
async function updateHeaderTemp(){
    const tempEl = document.getElementById("temp");

    if(!navigator.geolocation){
        tempEl.textContent = "Temp: N/A";
        return;
    }

    navigator.geolocation.getCurrentPosition(async pos => {
        try{
            const lat = pos.coords.latitude.toFixed(4);
            const lon = pos.coords.longitude.toFixed(4);

            const pointsResp = await fetch(`https://api.weather.gov/points/${lat},${lon}`);
            const pointsData = await pointsResp.json();
            const hourlyUrl = pointsData.properties.forecastHourly;

            const hourlyResp = await fetch(hourlyUrl);
            const hourlyData = await hourlyResp.json();
            const period = hourlyData.properties.periods[0];

            tempEl.textContent = `Temp: ${period.temperature}°${period.temperatureUnit}`;
        }catch(e){
            tempEl.textContent = "Temp: N/A";
        }
    });
}
updateHeaderTemp();
setInterval(updateHeaderTemp,300000);

/* SEVERE ALERTS */
const middleTN = [
    "DAVIDSON","CHEATHAM","DICKSON","HICKMAN","HOUSTON","HUMPHREYS",
    "MONTGOMERY","ROBERTSON","STEWART","SUMNER","WILLIAMSON",
    "WILSON","RUTHERFORD","CANNON","COFFEE","BEDFORD","MARSHALL",
    "MAURY","PERRY","LEWIS","WAYNE","LAWRENCE","GILES","LINCOLN",
    "MOORE","FRANKLIN","DEKALB","SMITH","JACKSON","PUTNAM",
    "OVERTON","CLAY","MACON","TROUSDALE","WHITE","CUMBERLAND",
    "FENTRESS"
];

async function updateAlerts(){
    const bulletinPanel = document.getElementById("bulletinPanel");

    try{
        const data = await fetch("https://api.weather.gov/alerts/active?area=TN")
            .then(r => r.json());

        const alerts = data.features || [];

        const filtered = alerts.filter(alert => {
            const areas = (alert.properties.areaDesc || "").toUpperCase();
            return middleTN.some(c => areas.includes(c));
        });

        const unique = [];
        const seen = new Set();

        filtered.forEach(alert => {
            const event = alert.properties.event || "UNKNOWN ALERT";
            if(!seen.has(event)){
                seen.add(event);
                unique.push(event);
            }
        });

        bulletinPanel.innerHTML = unique.length
            ? unique.map(e => `<div class="bulletin-line">${e.toUpperCase()}</div>`).join("")
            : "<div class='bulletin-line'>NO ACTIVE SEVERE ALERTS</div>";

    }catch(e){
        bulletinPanel.innerHTML = "<div class='bulletin-line'>NO DATA</div>";
    }
}
updateAlerts();
setInterval(updateAlerts,120000);

/* YOUR LOCATION PANEL */
async function updateLocationPanel(){
    const panel = document.getElementById("locationPanel");

    if(!navigator.geolocation){
        panel.innerHTML = "<div class='location-line'>Location unavailable.</div>";
        return;
    }

    navigator.geolocation.getCurrentPosition(async pos => {
        try{
            const lat = pos.coords.latitude.toFixed(4);
            const lon = pos.coords.longitude.toFixed(4);

            const pointsResp = await fetch(`https://api.weather.gov/points/${lat},${lon}`);
            const pointsData = await pointsResp.json();

            const city = pointsData.properties.relativeLocation.properties.city;
            const state = pointsData.properties.relativeLocation.properties.state;

            const hourlyUrl = pointsData.properties.forecastHourly;
            const hourlyResp = await fetch(hourlyUrl);
            const hourlyData = await hourlyResp.json();
            const period = hourlyData.properties.periods[0];

            panel.innerHTML = `
                <div class="location-line"><strong>${city}, ${state}</strong></div>
                <div class="location-line">Temperature: ${period.temperature}°${period.temperatureUnit}</div>
                <div class="location-line">Condition: ${period.shortForecast}</div>
                <div class="location-line">Humidity: ${period.relativeHumidity.value}%</div>
                <div class="location-line">Precipitation Chance: ${period.probabilityOfPrecipitation.value}%</div>
            `;
        }catch(e){
            panel.innerHTML = "<div class='location-line'>Unable to load data.</div>";
        }
    });
}
updateLocationPanel();
setInterval(updateLocationPanel,300000);
</script>

</body>
</html>
